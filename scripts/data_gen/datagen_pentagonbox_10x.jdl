# Pentagon-box 10× data-gen: 1000 workers × 1000 scrambles each = 1M scrambles
# (≈ 13M step-samples). Same settings as v2: all sectors, min_steps=5,
# max_steps=25, prime=1009. Seeds offset +100M from v2 so disjoint.
universe                 = vanilla
executable               = /het/p4/dshih/jet_images-deep_learning/SAILIR_phase2/scripts/data_gen/datagen_worker_pentagonbox_10x.sh
arguments                = $(Process) 1000 /het/p4/dshih/jet_images-deep_learning/SAILIR_phase2/data/pentagonbox_10x_raw_jsonl
output                   = /het/p4/dshih/jet_images-deep_learning/SAILIR_phase2/scripts/data_gen/logs/datagen_pb_10x_$(Process).out
error                    = /het/p4/dshih/jet_images-deep_learning/SAILIR_phase2/scripts/data_gen/logs/datagen_pb_10x_$(Process).err
log                      = /het/p4/dshih/jet_images-deep_learning/SAILIR_phase2/scripts/data_gen/logs/datagen_pb_10x_$(Process).log
environment              = "SAILIR_DIR=/het/p4/dshih/jet_images-deep_learning/SAILIR_phase2 PYTHON=/het/p4/dshih/jet_images-deep_learning/RL_MIR_IBP/conda_env/bin/python"
request_cpus             = 1
request_memory           = 6GB
request_disk             = 1GB
should_transfer_files    = NO
notification             = Error
queue 1000

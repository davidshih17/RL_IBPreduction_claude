+  // SAILIR no-symmetry mode: KIRA_NO_SYMMETRY=1 makes Kira skip ALL sector
+  // symmetry relations (e.g. the k1<->k2 loop-exchange mapping sector 161 to
+  // master 152), so the derived master basis is the IBP+LI-only set. Lets us
+  // rederive the Kira masters "sans symmetry identities".
+  if (std::getenv("KIRA_NO_SYMMETRY")) return 1;
   auto itSkip = integralfamily.skipSector[j].find(integralfamily.mask[j][it]);
 
   if (itSkip != integralfamily.skipSector[j].end()) return 1;
